# LiveKit API Keys
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The webhook URL that LiveKit will call when rooms are created/ended
# Must point to your FastAPI backend! (Use your Vercel/Render URL in production)
WEBHOOK_URL=http://192.168.100.132:8000/api/v1/calls/webhook

# Public IP for Coturn / WebRTC (Change this to your VPS IP when deployed!)
PUBLIC_IP=192.168.100.132
COTURN_SECRET=super_secret_coturn_key
DOMAIN=192.168.100.132
