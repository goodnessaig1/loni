LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=super_secret_livekit_key_change_me_in_prod
# NOTE: the real webhook path is /api/v1/livekit/webhook (calls_router is
# mounted under prefix "/livekit" in backend-new/app/api/router.py), NOT
# /api/v1/calls/webhook. This was wrong here and in livekit.yaml before -
# see livekit.yaml's `webhook:` block, which is what LiveKit actually reads;
# this WEBHOOK_URL var is just documentation/reference.
WEBHOOK_URL=https://api.yourdomain.com/api/v1/livekit/webhook

# Public IP for Coturn / WebRTC - required for the TURN relay to work for
# any device that isn't on the same LAN as the LiveKit host (Issue 9).
PUBLIC_IP=1.2.3.4
COTURN_SECRET=super_secret_coturn_key
DOMAIN=yourdomain.com
