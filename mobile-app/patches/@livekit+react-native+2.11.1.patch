+    /// LONI patch: the route audio is actually playing on, and the routes that exist right now.
+    private static func routeKind(_ port: AVAudioSession.Port) -> String? {
+        switch port {
+        case .builtInReceiver: return "earpiece"
+        case .builtInSpeaker: return "speaker"
+        case .bluetoothHFP, .bluetoothA2DP, .bluetoothLE: return "bluetooth"
+        case .headphones, .headsetMic, .usbAudio, .lineOut: return "headset"
+        case .carAudio: return "bluetooth"
+        default: return nil
+        }
+    }
+
+    @objc(getAudioRouteWithResolver:withRejecter:)
+    public func getAudioRoute(resolve: RCTPromiseResolveBlock, reject: RCTPromiseRejectBlock) {
+        let session = AVAudioSession.sharedInstance()
+        var available: [String] = []
+        if UIDevice.current.userInterfaceIdiom == .phone { available.append("earpiece") }
+        available.append("speaker")
+        for input in session.availableInputs ?? [] {
+            if let kind = LivekitReactNativeModule.routeKind(input.portType), kind != "earpiece", !available.contains(kind) {
+                available.append(kind)
+            }
+        }
+        var current: String? = nil
+        for output in session.currentRoute.outputs {
+            if let kind = LivekitReactNativeModule.routeKind(output.portType) {
+                current = kind
+                if !available.contains(kind) { available.append(kind) }
+                break
+            }
+        }
+        resolve(["available": available, "current": current ?? NSNull()])
+    }
+
+    /// LONI patch: route the call to "earpiece", "speaker", "bluetooth" or "headset".
+    @objc(selectAudioRoute:withResolver:withRejecter:)
+    public func selectAudioRoute(_ kind: String, resolve: RCTPromiseResolveBlock, reject: RCTPromiseRejectBlock) {
+        let session = AVAudioSession.sharedInstance()
+        do {
+            if kind == "speaker" {
+                try session.overrideOutputAudioPort(.speaker)
+            } else {
+                try session.overrideOutputAudioPort(.none)
+                let wanted: (AVAudioSession.Port) -> Bool = { port in
+                    switch kind {
+                    case "earpiece": return port == .builtInMic
+                    case "bluetooth": return port == .bluetoothHFP || port == .bluetoothLE
+                    case "headset": return port == .headsetMic || port == .usbAudio
+                    default: return false
+                    }
+                }
+                if let input = (session.availableInputs ?? []).first(where: { wanted($0.portType) }) {
+                    try session.setPreferredInput(input)
+                }
+            }
+        } catch {
+            reject("selectAudioRoute error", error.localizedDescription, error)
+            return
+        }
+        resolve(nil)
+    }
