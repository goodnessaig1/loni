# This project mixes React 19 / React Native 0.81 (new, strict peer ranges)
# with smaller native modules (react-native-callkeep,
# react-native-voip-push-notification, etc.) that haven't updated their
# declared peerDependencies ranges yet - npm's default strict resolver
# (npm 7+) rejects the install with ERESOLVE even though the actual code
# is compatible. This is standard, expected friction in the Expo/RN
# ecosystem, not a sign of a broken dependency tree.
#
# Setting this here means `npm install` works without needing
# --legacy-peer-deps on the command line every time (and so it also works
# for CI / anyone else who clones this repo and runs a plain npm install).
legacy-peer-deps=true
