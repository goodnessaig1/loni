{
  "expo": {
    "name": "Loni Server",
    "slug": "loni-server-app",
    "scheme": "loni-server",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "./plugins/withNotificationSound.js",
      "expo-font",
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Camera is required for video calls",
          "microphonePermission": "Microphone is required for audio calls"
        }
      ],
      [
        "@react-native-firebase/app",
        {}
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Loni uses your location while you are online so we can match you with nearby emergency ride requests and share your live position with the mother you are driving to.",
          "locationWhenInUsePermission": "Loni uses your location to match you with nearby emergency ride requests and to navigate to the pickup and hospital.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "./plugins/withCallKeepIOS.js",
        {
          "apsEnvironment": "development"
        }
      ],
      "./plugins/withNotifeeAndroid.js",
      "./plugins/withLiveKitAndroid.js",
      "./plugins/withCallKeepAndroid.js",
      "./plugins/withMainActivityLocked.js"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "bitcode": false,
      "bundleIdentifier": "com.loni.server",
      "infoPlist": {
        "UIBackgroundModes": ["audio", "voip", "fetch", "remote-notification", "location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.loni.server",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CALL_LOG"
      ]
    }
  }
}
